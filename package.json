{
  "name": "newestetica",
  "private": true,
  "version": "0.0.1",
  "description": "Sistema para clínica de estética da Fabiana Rosa - foco em mulheres 40+",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --filter frontend dev",
    "lint": "node --check lint-staged.config.mjs && pnpm --filter frontend lint",
    "format": "pnpm --filter frontend exec prettier --check ../lint-staged.config.mjs && pnpm --filter frontend format",
    "typecheck": "pnpm --filter frontend typecheck",
    "test": "pnpm --filter frontend test",
    "build": "pnpm --filter frontend build",
    "openspec": "openspec"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1"
  }
}
