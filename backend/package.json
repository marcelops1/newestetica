{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @newestetica/contracts run build && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "pnpm --filter @newestetica/contracts run build && tsc --noEmit",
    "test": "pnpm --filter @newestetica/contracts run build && vitest run --coverage",
    "mutation": "stryker run",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "@newestetica/contracts": "workspace:*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.3",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
