generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Slot {
  id              String    @id
  start           DateTime
  durationMinutes Int
  available       Boolean
  bookings        Booking[]
}

model Booking {
  id           String  @id
  slotId       String
  patientName  String
  patientPhone String
  treatment    String?
  notes        String?
  status       String
  slot         Slot    @relation(fields: [slotId], references: [id])

  @@unique([slotId], where: { status: "confirmed" })
}

model Procedure {
  id          String   @id
  name        String
  description String
  duration    String
  categories  String[]
  isActive    Boolean  @default(true)
}

model Testimonial {
  id      String @id
  quote   String
  author  String
  context String
}

model Post {
  id          String   @id
  title       String
  excerpt     String
  category    String
  content     String[]
  publishedAt DateTime @db.Date
}

/**
 * hasConsent fail-closed: sem consentimento claro, o caso não é servido
 * publicamente (docs/security/03-seguranca.md §5; spec backend-content).
 */
model BeforeAfterCase {
  id         String  @id
  title      String
  summary    String
  sessions   String
  recovery   String
  goal       String
  hasConsent Boolean @default(false)
}

/**
 * PII mínima de paciente (nome/telefone/finalidade). `status` fecha por padrão em
 * `active`; `anonymizedAt` marca a anonimização (PII substituída — nunca apagada
 * fisicamente). Nenhum campo clínico/saúde (docs/security/03-seguranca.md §4).
 */
model Patient {
  id           String       @id
  fullName     String
  phone        String
  purpose      String
  status       String       @default("active")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  anonymizedAt DateTime?
  attendances  Attendance[]
}

/**
 * Histórico operacional simples do UC 4.2.5: o que foi realizado por paciente.
 * Imutável (sem update/delete na API), sem snapshot de PII — o vínculo é por FK e a
 * visibilidade é herdada do Patient (anonimizada nunca é servida — docs/security §4).
 */
model Attendance {
  id          String   @id
  patientId   String
  summary     String
  performedAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  patient     Patient  @relation(fields: [patientId], references: [id])

  @@index([patientId, performedAt])
}
